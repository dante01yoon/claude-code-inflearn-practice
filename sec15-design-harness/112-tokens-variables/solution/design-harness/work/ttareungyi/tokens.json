  "$extensions": {
    "harness.figmaFontStyles": {
      "Noto Sans KR": {
        "400": "Regular",
        "500": "Medium",
        "700": "Bold"
      }
    },
    "harness.typeScale": [
      {
        "role": "display",
        "size": "font-size.display",
        "weight": "font-weight.bold",
        "lineHeight": "line-height.tight",
        "use": "대여소 시트의 남은 자전거 수(숫자 하나)"
      },
      {
        "role": "count",
        "size": "font-size.count",
        "weight": "font-weight.bold",
        "lineHeight": "line-height.tight",
        "use": "목록 행의 남은 자전거 수"
      },
      {
        "role": "title",
        "size": "font-size.title",
        "weight": "font-weight.bold",
        "lineHeight": "line-height.tight",
        "use": "대여소 이름(시트), 시트 제목"
      },
      {
        "role": "body",
        "size": "font-size.body",
        "weight": "font-weight.medium",
        "lineHeight": "line-height.body",
        "use": "행의 대여소 이름, 상태 문구, 버튼"
      },
      {
        "role": "label",
        "size": "font-size.label",
        "weight": "font-weight.regular",
        "lineHeight": "line-height.body",
        "use": "거치대 수, 기준 시각, 전환 탭, 핀 숫자(Bold)"
      },
      {
        "role": "caption",
        "size": "font-size.caption",
        "weight": "font-weight.regular",
        "lineHeight": "line-height.body",
        "use": "출처표시, © OpenStreetMap"
      }
    ],
    "harness.grid": {
      "base": 4,
      "margin": 16,
      "columns": 4,
      "gutter": 12
    },
    "harness.allowRawRadius": [
      0
    ],
    "harness.contrastPairs": [
      {
        "fg": "{color.text}",
        "bg": "{color.surface}",
        "min": 4.5,
        "where": "시트·목록 본문, 대여소 이름, 0대 아닌 숫자"
      },
      {
        "fg": "{color.text}",
        "bg": "{color.surface-sunken}",
        "min": 4.5,
        "where": "검색바 입력값, 전환 탭 미선택 칸"
      },
      {
        "fg": "{color.text}",
        "bg": "{color.map-ground}",
        "min": 4.5,
        "where": "지도 위 지명(map-labels)"
      },
      {
        "fg": "{color.text-muted}",
        "bg": "{color.surface}",
        "min": 4.5,
        "where": "거치대 수, 기준 시각, 출처표시"
      },
      {
        "fg": "{color.text-muted}",
        "bg": "{color.surface-sunken}",
        "min": 4.5,
        "where": "검색바 플레이스홀더, 전환 탭 미선택 글자"
      },
      {
        "fg": "{color.text-muted}",
        "bg": "{color.map-ground}",
        "min": 4.5,
        "where": "© OpenStreetMap 표시"
      },
      {
        "fg": "{color.on-ink}",
        "bg": "{color.ink}",
        "min": 4.5,
        "where": "자전거 있는 핀 숫자, 전환 탭 선택 칸"
      },
      {
        "fg": "{color.text}",
        "bg": "{color.stock-low}",
        "min": 4.5,
        "where": "1~2대 핀 숫자"
      },
      {
        "fg": "{color.text}",
        "bg": "{color.stock-low-soft}",
        "min": 4.5,
        "where": "1~2대 행의 '얼마 안 남았어요' 표시"
      },
      {
        "fg": "{color.stock-zero}",
        "bg": "{color.surface}",
        "min": 4.5,
        "where": "0대 핀 숫자(흰 바탕 빨간 테), 목록의 0대 숫자"
      },
      {
        "fg": "{color.stock-zero}",
        "bg": "{color.stock-zero-soft}",
        "min": 4.5,
        "where": "대여소 시트 0대 안내 띠"
      },
      {
        "fg": "{color.text}",
        "bg": "{color.stock-zero-soft}",
        "min": 4.5,
        "where": "0대 안내 띠의 본문, 에러 배너 본문"
      },
      {
        "fg": "{color.on-action}",
        "bg": "{color.action}",
        "min": 4.5,
        "where": "다시 시도 버튼"
      },
      {
        "fg": "{color.action}",
        "bg": "{color.surface}",
        "min": 4.5,
        "where": "가까운 대여소 보기 등 텍스트 버튼"
      },
      {
        "fg": "{color.action}",
        "bg": "{color.action-soft}",
        "min": 4.5,
        "where": "선택된 행·검색 결과 강조"
      },
      {
        "fg": "{color.text}",
        "bg": "{color.action-soft}",
        "min": 4.5,
        "where": "선택된 행의 대여소 이름"
      }
    ],
    "harness.decisions": [
      "핀 기본색은 따릉이 초록이 아닌 짙은 잉크(#17222B). 지도 바탕에 공원(#DCE8D3)·한강(#C9DDE8)이 넓게 깔려 초록 핀이 묻히고, 숫자 대비도 잉크+흰 글자가 16:1로 가장 높다.",
      "초록(#00764A)은 누르는 행동(다시 시도, 텍스트 버튼, 선택 강조)에만 쓴다. research의 '브랜드 색 한 가지를 행동 버튼에 일관되게'를 따르되, 재고 상태색과 섞이지 않게 분리했다.",
      "재고 상태는 색+모양 두 겹: 있음=잉크 원, 1~2대=호박색 둥근 사각+잉크 테, 0대=흰 원+빨간 테+빨간 숫자. 색을 못 구분해도 모양으로 읽힌다(PRD F0).",
      "크림 바탕+테라코타 대신 흰 시트+차가운 회색(slate). 지도 바탕이 이미 따뜻한 회색(#F1F0EC)이라 시트가 지도와 구분돼야 한다.",
      "둥근 카드+회색 그림자를 쓰지 않는다. 바텀시트는 위쪽 모서리만 16px, 지도와는 1px 선으로 나눈다. 목록은 카드가 아니라 구분선 있는 행.",
      "의미 없는 01/02 표식 대신 원본의 실제 대여소 번호(102., 4207.)를 그대로 둔다(ia 결정). 대문자 라벨은 한국어 UI라 쓰지 않는다.",
      "숫자가 주인공: 목록 숫자 28px Bold, 시트 숫자 56px Bold. '남은 수 / 거치대 수'에서 거치대는 14px muted로 낮춘다."
    ]
  }
}
