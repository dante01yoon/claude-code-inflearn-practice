{
  "$description": "따릉이 대여소 현황 토큰. primitive(값) -> semantic(의도). 코드는 semantic만 쓴다.",
  "primitive": {
    "color": {
      "$type": "color",
      "green-700": {
        "$value": "#1F6B3A"
      },
      "green-50": {
        "$value": "#EAF4EC"
      },
      "red-700": {
        "$value": "#B3261E"
      },
      "red-50": {
        "$value": "#FBECEB"
      },
      "gray-900": {
        "$value": "#1C1F1D"
      },
      "gray-600": {
        "$value": "#55605A"
      },
      "gray-200": {
        "$value": "#DCE2DE"
      },
      "white": {
        "$value": "#FFFFFF"
      }
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "$value": "{primitive.color.green-700}"
    },
    "brand-soft": {
      "$value": "{primitive.color.green-50}"
    },
    "danger": {
      "$value": "{primitive.color.red-700}"
    },
    "danger-soft": {
      "$value": "{primitive.color.red-50}"
    },
    "text": {
      "$value": "{primitive.color.gray-900}"
    },
    "text-muted": {
      "$value": "{primitive.color.gray-600}"
    },
    "on-brand": {
      "$value": "{primitive.color.white}"
    },
    "surface": {
      "$value": "{primitive.color.white}"
    },
    "border": {
      "$value": "{primitive.color.gray-200}"
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "6": {
      "$value": "24px"
    },
    "8": {
      "$value": "32px"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "6px"
    },
    "md": {
      "$value": "12px"
    }
  },
  "size": {
    "$type": "dimension",
    "touch": {
      "$value": "44px"
    },
    "header": {
      "$value": "56px"
    }
  },
  "font-size": {
    "$type": "dimension",
    "caption": {
      "$value": "13px"
    },
    "body": {
      "$value": "16px"
    },
    "title": {
      "$value": "20px"
    },
    "display": {
      "$value": "56px"
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "bold": {
      "$value": 700
    }
  },
  "line-height": {
    "$type": "number",
    "tight": {
      "$value": 1.2
    },
    "body": {
      "$value": 1.5
    }
  },
  "font-family": {
    "$type": "fontFamily",
    "base": {
      "$value": [
        "Pretendard",
        "Apple SD Gothic Neo",
        "Noto Sans KR",
        "sans-serif"
      ]
    }
  },
  "$extensions": {
    "harness.contrastPairs": [
      {
        "fg": "{color.text}",
        "bg": "{color.surface}",
        "min": 4.5
      },
      {
        "fg": "{color.text-muted}",
        "bg": "{color.surface}",
        "min": 4.5
      },
      {
        "fg": "{color.on-brand}",
        "bg": "{color.brand}",
        "min": 4.5
      },
      {
        "fg": "{color.danger}",
        "bg": "{color.danger-soft}",
        "min": 4.5
      },
      {
        "fg": "{color.brand}",
        "bg": "{color.brand-soft}",
        "min": 4.5
      }
    ],
    "harness.grid": {
      "base": 4,
      "margin": 16,
      "columns": 4,
      "gutter": 16
    },
    "harness.allowRawRadius": [
      0
    ]
  }
}
