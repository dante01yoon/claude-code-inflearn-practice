      },
      {
        "fg": "{color.text}",
        "bg": "{color.zero-soft}",
        "min": 4.5,
        "where": "0대 행의 대여소 이름"
      },
      {
        "fg": "{color.text-muted}",
        "bg": "{color.zero-soft}",
        "min": 4.5,
        "where": "0대 행의 거치대 수"
      },
