  "$extensions": {
    "harness.contrastPairs": [
      {
        "fg": "{color.text}",
        "bg": "{color.surface}",
        "min": 4.5,
        "where": "대여소 이름, 헤더 제목, 상태 문구"
      },
      {
        "fg": "{color.text-muted}",
        "bg": "{color.surface}",
        "min": 4.5,
        "where": "거치대 수, 위·경도, 출처, 로딩 문구"
      },
      {
        "fg": "{color.brand}",
        "bg": "{color.surface}",
        "min": 4.5,
        "where": "남은 자전거 수(1대 이상), 상세 큰 숫자, 뒤로 버튼"
      },
      {
        "fg": "{color.on-brand}",
        "bg": "{color.brand}",
        "min": 4.5,
        "where": "다시 시도 버튼"
      },
      {
        "fg": "{color.brand}",
        "bg": "{color.brand-soft}",
        "min": 4.5,
        "where": "행 눌림 상태의 남은 수"
      },
      {
        "fg": "{color.text}",
        "bg": "{color.brand-soft}",
        "min": 4.5,
        "where": "행 눌림 상태의 이름"
      },
