{
  "$description": "따릉이 대여소 현황 토큰. primitive(값) -> semantic(의도). 화면은 semantic만 쓴다.",
  "primitive": {
    "color": {
      "$type": "color",
      "green-700": { "$value": "#0A6B47" },
      "green-50": { "$value": "#E8F3EE" },
      "red-700": { "$value": "#B3261E" },
      "red-50": { "$value": "#FDEEEC" },
      "ink-900": { "$value": "#18211D" },
      "ink-600": { "$value": "#505C56" },
      "ink-200": { "$value": "#D3DBD7" },
      "white": { "$value": "#FFFFFF" }
    },
    "dimension": {
      "$type": "dimension",
      "4": { "$value": "4px" },
      "8": { "$value": "8px" },
      "12": { "$value": "12px" },
      "16": { "$value": "16px" },
      "24": { "$value": "24px" },
      "32": { "$value": "32px" },
      "44": { "$value": "44px" },
      "56": { "$value": "56px" },
      "72": { "$value": "72px" }
    }
  },
  "color": {
    "$type": "color",
    "brand": { "$value": "{primitive.color.green-700}", "$description": "다시 시도 버튼, 남은 자전거 수(1대 이상)" },
    "brand-soft": { "$value": "{primitive.color.green-50}", "$description": "버튼 눌림, 행 눌림 배경" },
    "on-brand": { "$value": "{primitive.color.white}" },
    "zero": { "$value": "{primitive.color.red-700}", "$description": "0대 숫자·태그·왼쪽 막대, 에러 아이콘. 브랜드색과 구분" },
    "zero-soft": { "$value": "{primitive.color.red-50}", "$description": "0대 행 배경" },
    "text": { "$value": "{primitive.color.ink-900}" },
    "text-muted": { "$value": "{primitive.color.ink-600}", "$description": "거치대 수, 위·경도, 출처" },
    "surface": { "$value": "{primitive.color.white}" },
    "border": { "$value": "{primitive.color.ink-200}", "$description": "행 구분선, 스켈레톤. 글자에 쓰지 않음" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "{primitive.dimension.4}" },
    "2": { "$value": "{primitive.dimension.8}" },
    "3": { "$value": "{primitive.dimension.12}" },
    "4": { "$value": "{primitive.dimension.16}" },
    "6": { "$value": "{primitive.dimension.24}" },
    "8": { "$value": "{primitive.dimension.32}" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "{primitive.dimension.4}", "$description": "0대 태그" },
    "md": { "$value": "{primitive.dimension.8}", "$description": "버튼" }
  },
  "size": {
    "$type": "dimension",
    "touch": { "$value": "{primitive.dimension.44}" },
    "header": { "$value": "{primitive.dimension.56}" },
    "row": { "$value": "{primitive.dimension.72}" },
    "zero-bar": { "$value": "{primitive.dimension.4}", "$description": "0대 행 왼쪽 막대 폭" }
  },
  "font-size": {
    "$type": "dimension",
    "caption": { "$value": "13px", "$description": "위·경도, 출처표시" },
    "body": { "$value": "16px", "$description": "대여소 이름, 상태 문구, 버튼" },
    "title": { "$value": "20px", "$description": "헤더 제목, 목록의 남은 수" },
    "display": { "$value": "48px", "$description": "상세의 남은 자전거 수 숫자" }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "bold": { "$value": 700 }
  },
  "line-height": {
    "$type": "number",
    "tight": { "$value": 1.2 },
    "body": { "$value": 1.5 }
  },
  "font-family": {
    "$type": "fontFamily",
    "base": { "$value": ["Noto Sans KR", "Apple SD Gothic Neo", "sans-serif"] }
  },
  "$extensions": {
    "harness.contrastPairs": [
      { "fg": "{color.text}", "bg": "{color.surface}", "min": 4.5, "where": "대여소 이름, 헤더 제목, 상태 문구" },
      { "fg": "{color.text-muted}", "bg": "{color.surface}", "min": 4.5, "where": "거치대 수, 위·경도, 출처, 로딩 문구" },
      { "fg": "{color.brand}", "bg": "{color.surface}", "min": 4.5, "where": "남은 자전거 수(1대 이상), 상세 큰 숫자, 뒤로 버튼" },
      { "fg": "{color.on-brand}", "bg": "{color.brand}", "min": 4.5, "where": "다시 시도 버튼" },
      { "fg": "{color.brand}", "bg": "{color.brand-soft}", "min": 4.5, "where": "행 눌림 상태의 남은 수" },
      { "fg": "{color.text}", "bg": "{color.brand-soft}", "min": 4.5, "where": "행 눌림 상태의 이름" },
      { "fg": "{color.zero}", "bg": "{color.surface}", "min": 4.5, "where": "상세 0대 숫자, 에러 아이콘" },
      { "fg": "{color.zero}", "bg": "{color.zero-soft}", "min": 4.5, "where": "0대 행의 '0대'와 '자전거 없음' 태그" },
      { "fg": "{color.text}", "bg": "{color.zero-soft}", "min": 4.5, "where": "0대 행의 대여소 이름" },
      { "fg": "{color.text-muted}", "bg": "{color.zero-soft}", "min": 4.5, "where": "0대 행의 거치대 수" }
    ],
    "harness.grid": { "base": 4, "margin": 16, "columns": 4, "gutter": 16 },
    "harness.allowRawRadius": [0],
    "harness.rationale": [
      "색: 따릉이 녹색 하나를 브랜드로, 0대는 별도 적색(research: 경고색은 브랜드색과 구분). 배경은 흰색 단색 — 크림+테라코타 기본값을 쓰지 않음.",
      "0대 강조는 색만으로 하지 않음: 왼쪽 4px 막대(size.zero-bar) + '자전거 없음' 글자 태그 + 굵은 '0대'. 흑백에서도 구분됨.",
      "목록은 카드+그림자가 아니라 전폭 행+구분선. 5곳뿐이라 카드 여백이 낭비되고, 훑어 내려가는 비교가 과업이라 행이 맞음. 그림자 토큰 없음.",
      "대문자 라벨 없음(한글 UI). 이름 앞 '102.'는 원본 대여소 번호라 의미 있는 표식이므로 유지(사람 결정). 장식용 01/02 표식은 쓰지 않음.",
      "기준 서체는 Noto Sans KR(사람 결정, 2026-10-19): Pretendard가 Figma 파일에서 불러와지지 않아 교체. 숫자 자릿수는 tabular figures('tnum')로 맞추되 Figma에서 적용 여부는 미확인.",
      "타입 스케일 4단계 13/16/20/48. 위·경도는 caption+text-muted로 가장 낮은 위계(사람 결정).",
      "격자: 4px 기본, 좌우 16px, 4열·거터 16(390 폭 → 열 폭 75.5). 행 높이 72, 헤더 56."
    ]
  }
}
