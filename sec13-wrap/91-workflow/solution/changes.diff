@@ -20,6 +20,16 @@ export function compareDaily(a, b) {
   };
 }
 
+// 하루 평균 승하차(entries[].riders)로 매긴 전체 순위(답 카드)를 entries 순서대로 돌려준다.
+// 화면에 보이는 반올림 값으로 비교하고, 동률이면 같은 순위(나보다 많은 역 수 + 1)다.
+export function riderRanks(entries) {
+  const shown = entries.map((e) => Math.round(e.riders));
+  const sorted = [...shown].sort((a, b) => b - a);
+  const rankOf = new Map();
+  sorted.forEach((v, i) => rankOf.has(v) || rankOf.set(v, i + 1));
+  return shown.map((v) => rankOf.get(v));
+}
+
 // ---- 주소로 공유: ?compare=강남,홍대입구 ----
 // 쉼표는 그대로 두고 역 이름만 인코딩한다(주소창에서 읽기 쉽게). 다른 검색 파라미터는 건드리지 않는다.
 export const COMPARE_PARAM = "compare";
